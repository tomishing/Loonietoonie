# Copy to backend/.env and fill in real values. Never commit backend/.env.
# A repo-root .env is also read; values here take precedence.

APP_ENV=development
# JSON list of allowed frontend origins (CORS).
FRONTEND_ORIGINS=["http://localhost:5173"]
# Where the browser returns after Google Sign-In.
FRONTEND_URL=http://localhost:5173

# Anthropic Claude API (receipt parsing + chatbot)
ANTHROPIC_API_KEY=
ANTHROPIC_RECEIPT_MODEL=claude-haiku-5-5
# Spending chatbot. claude-haiku-5-5 is much cheaper if answers are good enough for you.
ANTHROPIC_CHAT_MODEL=claude-opus-5-5

# Google OAuth 2.0 "Web application" client (Sign-In with drive.file scope).
# The Google Cloud project must have the Sheets + Drive APIs enabled, and
# GOOGLE_REDIRECT_URI must be listed under "Authorized redirect URIs".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback
# Optional: Google callback for Android app sign-ins when the phone reaches the backend at
# another address than the website, e.g. https://<laptop>.<tailnet>.ts.net/api/auth/callback
# (Tailscale). Add it to the OAuth client's "Authorized redirect URIs" too. Empty: GOOGLE_REDIRECT_URI.
APP_GOOGLE_REDIRECT_URI=

# Encrypts the session cookie, which holds the Google refresh token. At least 32 characters.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone out.
SESSION_SECRET=
SESSION_MAX_AGE_DAYS=30

# Default receipt currency (users can change it on the review screen)
DEFAULT_CURRENCY=CAD

# Bank and card linking (Plaid). Leave empty to turn the feature off.
# Keys: dashboard.plaid.com → Developers → Keys. Use the Sandbox secret with PLAID_ENV=sandbox.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# JSON list of countries whose banks appear in Plaid Link.
PLAID_COUNTRY_CODES=["CA","US"]
# Google emails that may link banks on the web app (phase 12), e.g. ["you@example.com"]. Empty: nobody.
# The Android app never offers Plaid.
PLAID_ALLOWED_EMAILS=[]
# Encrypts Plaid access tokens in the token store (backend/data/tokens.sqlite3).
# Generate with: python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Losing or changing it means every bank has to be linked again.
TOKEN_ENCRYPTION_KEY=
