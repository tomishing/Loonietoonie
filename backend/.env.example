# Copy to backend/.env and fill in real values. Never commit backend/.env.
# A repo-root .env is also read; values here take precedence.

APP_ENV=development
# JSON list of allowed frontend origins (CORS).
FRONTEND_ORIGINS=["http://localhost:5173"]
# Where the browser returns after Google Sign-In.
FRONTEND_URL=http://localhost:5173

# Anthropic Claude API (receipt parsing + chatbot)
ANTHROPIC_API_KEY=
ANTHROPIC_RECEIPT_MODEL=claude-haiku-5-5

# Google OAuth 2.0 "Web application" client (Sign-In with drive.file scope).
# The Google Cloud project must have the Sheets + Drive APIs enabled, and
# GOOGLE_REDIRECT_URI must be listed under "Authorized redirect URIs".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback

# Encrypts the session cookie, which holds the Google refresh token. At least 32 characters.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it signs everyone out.
SESSION_SECRET=
SESSION_MAX_AGE_DAYS=30

# Default receipt currency (users can change it on the review screen)
DEFAULT_CURRENCY=USD
