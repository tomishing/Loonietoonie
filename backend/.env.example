# Copy to backend/.env and fill in real values. Never commit backend/.env.
# A repo-root .env is also read; values here take precedence.

APP_ENV=development
# JSON list of allowed frontend origins (CORS).
FRONTEND_ORIGINS=["http://localhost:5173"]

# Anthropic Claude API (receipt parsing + chatbot)
ANTHROPIC_API_KEY=
ANTHROPIC_RECEIPT_MODEL=claude-haiku-5-5

# Google OAuth 2.0 (Sign-In with drive.file scope). The Google Cloud project
# must have the Sheets + Drive APIs enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback

# Random string for signing session cookies, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`
SESSION_SECRET=

# Default receipt currency (users can change it on the review screen)
DEFAULT_CURRENCY=USD
