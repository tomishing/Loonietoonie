# Copy to frontend/.env. Only VITE_* variables are exposed to the browser,
# so never put secrets (API keys, client secrets) in this file.

# Base URL of the FastAPI backend. Leave empty in dev to use the Vite proxy (/api -> backend).
VITE_API_BASE_URL=

# Where the Vite dev proxy forwards /api requests (dev only).
VITE_DEV_BACKEND_URL=http://localhost:8000
