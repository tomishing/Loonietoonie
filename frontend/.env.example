# Copy to frontend/.env. Only VITE_* variables are exposed to the browser,
# so never put secrets (API keys, client secrets) in this file.

# Base URL of the FastAPI backend. Leave empty in dev to use the Vite proxy (/api -> backend).
VITE_API_BASE_URL=

# Where the Vite dev proxy forwards /api requests (dev only).
VITE_DEV_BACKEND_URL=http://localhost:8000

# The Android app is built with `--mode android` (npm run android:*), which also reads
# frontend/.env.android.local (git-ignored). Put the HTTPS backend the phone should use there:
#   VITE_API_BASE_URL=https://<laptop>.<tailnet>.ts.net
# Without it, the app talks to http://localhost:8000 (needs `adb reverse tcp:8000 tcp:8000` over USB).
